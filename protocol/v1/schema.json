{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remoteai.local/protocol/v1/schema.json",
  "title": "RemoteAI Protocol v1",
  "type": "object",
  "required": ["protocolVersion", "messageId", "kind", "type", "payload"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "messageId": { "type": "string", "format": "uuid" },
    "kind": { "enum": ["request", "response", "event"] },
    "requestId": { "type": ["string", "null"], "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 0 },
    "conversationId": { "type": ["string", "null"] },
    "type": {
      "enum": [
        "provider.status", "conversations.daily.list", "projects.list",
        "projects.conversations.list", "conversation.history", "conversation.start",
        "conversation.resume", "conversation.send", "conversation.interrupt",
        "approval.decide", "files.list", "files.metadata", "files.preview",
        "transfers.create", "transfers.chunk", "transfers.finish", "transfers.cancel",
        "audit.list", "diagnostics.get", "device.revoke", "conversation.started",
        "conversation.user_message", "conversation.delta", "conversation.message_completed",
        "tool.started", "tool.updated", "tool.completed", "approval.requested",
        "approval.resolved", "turn.completed", "turn.failed", "turn.interrupted",
        "provider.status_changed"
      ]
    },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
