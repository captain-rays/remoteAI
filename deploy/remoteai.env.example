# Configuration for the installed RemoteAI services.
#
# Copy to ~/.config/remoteai/agent.env and edit. It holds one machine's
# choices — a tunnel hostname, model overrides — so it is never committed.
#
#     mkdir -p ~/.config/remoteai
#     cp deploy/remoteai.env.example ~/.config/remoteai/agent.env
#
# Then: scripts/remoteai-service.sh install
#
# Lines are KEY=VALUE and are sourced by the installer, so quote any value
# containing a space. Everything is optional except REMOTEAI_PUBLIC_ORIGIN,
# which the phone stores when it pairs and dials thereafter.

# The address the phone reaches this Mac at. Must be the hostname routed to
# your named tunnel, and must be https — the client refuses a plaintext origin
# that is not loopback.
REMOTEAI_PUBLIC_ORIGIN=https://remoteai.example.org

# Name of the Cloudflare named tunnel to run (cloudflared tunnel create <name>,
# then cloudflared tunnel route dns <name> <hostname>).
REMOTEAI_TUNNEL_NAME=remoteai

# Where the agent writes its one-time pairing payload. scripts/agent-pairing-qr
# turns this into a QR to scan. Owner-only: it is a bearer credential.
REMOTEAI_PAIRING_FILE="$HOME/Library/Application Support/RemoteAI/pairing.json"

# Optional model overrides.
#
# Claude: the CLI otherwise inherits this Mac's configured default, which may be
# a model the account cannot use — the turn then fails with a credit error.
#REMOTEAI_CLAUDE_MODEL=claude-sonnet-5
#
# Codex: a thread records the model it was created with, and a thread pinned to
# a retired model cannot be resumed at all.
#REMOTEAI_CODEX_MODEL=gpt-5.6-sol

# Permission mode for phone-driven Claude sessions. The CLI cannot forward a
# permission prompt to a remote client, so the default runs unattended.
# `manual` restores refusal; `auto` approves each request but keeps the
# working-directory sandbox.
#REMOTEAI_CLAUDE_PERMISSION_MODE=bypassPermissions
